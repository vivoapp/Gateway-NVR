# Template for /etc/vivo/cloud.env (owner root, readable by the haris user, not by others).
# Never put the real values in Git. Format: KEY=value, no quotes, no spaces around "=".
S3_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
S3_REGION=REGION
S3_BUCKET=BUCKET_NAME
S3_KEY_PREFIX=SITE_ID
S3_ACCESS_KEY=APPLICATION_KEY_ID
S3_SECRET_KEY=APPLICATION_KEY
