# Template for /etc/vivo/cloud.env on the gateway. Never put the real values in Git.
# Owner root; it must be READABLE BY THE `haris` USER (for example group haris, mode 640), because the uploader
# runs in that user's rootless Docker. Format: KEY=value, no quotes, no spaces around "=".
# Read by compose.yaml (env_file). These values win over the same settings in config.gateway.toml.

# Backblaze B2 S3 endpoint of the bucket's region (shown in the B2 console), for example
# https://s3.eu-central-003.backblazeb2.com
S3_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
S3_REGION=REGION
# The bucket for the segments.
S3_BUCKET=BUCKET_NAME
# The site (gateway) id: every object of this gateway is stored under <S3_KEY_PREFIX>/<camera>/<date>/<file>.mp4.
# The uploader deletes only inside this prefix (and only a copy that failed its own check).
S3_KEY_PREFIX=SITE_ID
# A B2 application key limited to this bucket: key ID and key. Needs list, read, write and delete in the bucket.
S3_ACCESS_KEY=APPLICATION_KEY_ID
S3_SECRET_KEY=APPLICATION_KEY
