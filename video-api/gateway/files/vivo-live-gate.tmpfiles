# /etc/tmpfiles.d/vivo-live-gate.conf: made at every boot. The Video API container (user 10001)
# writes cut and release requests into requests/; vivo-live-gate (root) reads and deletes them.
# requests/ belongs to root with group 10001 (the API) allowed to write: vivo-live-gate runs with
# only CAP_NET_ADMIN and CAP_NET_RAW, so as root without CAP_DAC_OVERRIDE it can open the folder
# only as its owner (findings F11).
d /run/vivo-live-gate          0755 root  root  -
d /run/vivo-live-gate/requests 0770 root  10001 -
