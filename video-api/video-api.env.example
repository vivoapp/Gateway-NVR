# Vivo Video API settings: /etc/vivo/video-api.env on the gateway (root, mode 600).
# gateway/setup.sh makes it from this file and fills FRIGATE_PASSWORD (random) and the go2rtc login
# (copied from /etc/vivo/secrets.env). Never commit the real file. Limits: contract section 11.1.

# Grants must carry aud = vivo-gw:<GATEWAY_ID>. setup.sh sets it to the gateway's host name.
GATEWAY_ID=vivo-gateway

# Frigate's viewer account for the API (made by setup.sh; never an admin account)
FRIGATE_USER=video_api

# Remote live view (M15): Vivo's STUN/TURN server. Empty until it exists; the building network works without it.
#   STUN_URLS=stun:turn.example.com:3478
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
#   TURN_SECRET=<coturn static-auth-secret>
STUN_URLS=
TURN_URLS=
TURN_SECRET=

# Limits
LIVE_SITE_REMOTE_MAX=6
LIVE_CAMERA_MAX=5
CLIP_MAX_SECONDS=1800
CLIP_KEEP=3600
CLIP_STORE_MAX_GB=5

# Browser clients on another origin, comma separated (for example Vivo Watch on the web). Empty: none.
CORS_ORIGINS=
