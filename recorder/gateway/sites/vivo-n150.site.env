# Site settings for Vivo's reference gateway (Intel N150, Vivo office rack, Puerto Rico).
# Installed as /etc/vivo/site.env by: sudo gateway/setup.sh --site gateway/sites/vivo-n150.site.env
# Not secret. Values checked on the gateway on Oct 20, 2026 (docs/findings.md F4).

# Gateway address on the office/camera LAN (enp1s0, static; router 192.168.30.1)
GATEWAY_LAN_IP=192.168.30.200

# Live view, Frigate UI and RTSP restream: the office LAN.
# Vivo VPN users (10.50.0.0/24) reach the gateway NATed from 192.168.30.9, so the LAN covers them.
LAN_CIDRS=192.168.30.0/24

# SSH: the LAN (which includes the NATed VPN), plus the VPN subnet in case the VPN is ever routed
# without NAT.
ADMIN_CIDRS=192.168.30.0/24,10.50.0.0/24

# Recording disk mount point
MEDIA_ROOT=/srv/vivo

# NTP: the Ubuntu pool (the gateway has internet access)
NTP_SERVERS=
