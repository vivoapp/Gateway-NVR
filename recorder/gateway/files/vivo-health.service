# Vivo gateway health endpoint (M22): http://<GATEWAY_LAN_IP>:9101/health and /metrics.
# Installed by gateway/setup.sh. Read only; runs as root to read SMART, Docker and chrony.
[Unit]
Description=Vivo gateway health endpoint (M22)
After=docker.service network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 @INSTALL_DIR@/tools/health.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
