# Pinned versions for the Vivo gateway. Every install uses exactly these.
# Change them only through a reviewed commit, and record the change in CHANGELOG.md.

# Ubuntu Server 24.04 LTS (noble), x86_64
UBUNTU_VERSION_ID=24.04

# Kernel: Ubuntu's hardware enablement (HWE) kernel series for 24.04. The 6.8 GA kernel does not
# drive the N150 graphics (PCI 8086:46d4), so there is no Quick Sync without it (docs/findings.md F3).
# A meta package: it follows Ubuntu's security updates within the HWE series.
KERNEL_PACKAGE=linux-generic-hwe-24.04

# Docker Engine and Compose from download.docker.com (apt packages, held after install)
DOCKER_CE_VERSION=5:29.9.1-1~ubuntu.24.04~noble
CONTAINERD_VERSION=2.4.2-2~ubuntu.24.04~noble
COMPOSE_PLUGIN_VERSION=5.6.0-1~ubuntu.24.04~noble

# Frigate (standard x86 image; Intel decoding uses VAAPI inside the image)
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate
FRIGATE_VERSION=0.18.0
FRIGATE_DIGEST=sha256:9678a83a76e4730ac7d9ea7428370e32ae656d6b312aaad30d6c69f3fef14d35

# go2rtc (standalone; same version Frigate 0.18.0 bundles)
GO2RTC_IMAGE=alexxit/go2rtc
GO2RTC_VERSION=1.9.14
GO2RTC_DIGEST=sha256:675c318b23c06fd862a61d262240c9a63436b4050d177ffc68a32710d9e05bae
