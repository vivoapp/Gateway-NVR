# Copy to /etc/vivo/site.env on the gateway. These values are not secret.

# Gateway address on the camera/office LAN (used as the WebRTC address for live view)
GATEWAY_LAN_IP=192.0.2.10

# Networks allowed to reach the gateway's services (comma separated CIDRs).
# LAN_CIDRS: the local network that needs live view, Frigate UI and RTSP.
# ADMIN_CIDRS: where SSH is allowed from (LAN and the Vivo VPN).
LAN_CIDRS=192.0.2.0/24
ADMIN_CIDRS=192.0.2.0/24,10.8.0.0/24

# Recording disk mount point. Everything Frigate writes lives under it.
MEDIA_ROOT=/srv/vivo

# NTP servers for chrony (space separated). Leave empty for the Ubuntu pool.
NTP_SERVERS=
