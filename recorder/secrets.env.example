# Copy to /etc/vivo/secrets.env on the gateway (owner root, mode 600).
# Never commit the real file. gateway/setup.sh creates it from this template.
#
# URL-encode special characters in passwords that go into RTSP URLs
# (for example @ becomes %40, : becomes %3A, / becomes %2F).

# go2rtc web UI and API (port 1984)
GO2RTC_API_USER=vivo
GO2RTC_API_PASSWORD=change-me

# go2rtc RTSP restream (port 8554). Frigate reads the cameras through this.
FRIGATE_GO2RTC_RTSP_USER=vivo
FRIGATE_GO2RTC_RTSP_PASSWORD=change-me

# One pair per credentials name in cameras.yaml (the reference gateway's ten cameras share VIVOCAM)
VIVOCAM_USER=admin
VIVOCAM_PASSWORD=change-me
